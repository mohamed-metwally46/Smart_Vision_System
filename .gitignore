# ── Smart Vision System — .gitignore ─────────────────────────────────────────

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
*.env.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
.venv/
env/
.env/

# ── AI model weights (large binary files — store separately or in DVC) ────────
models/*.pt
models/*.pth
models/*.onnx

# Keep the README
!models/README.md

# Allow tracking of python scripts in models
!models/*.py

# ── Heatmaps (generated at runtime) ──────────────────────────────────────────
backend/static/heatmaps/

# ── Datasets / Generated Data ────────────────────────────────────────────────
data/
datasets/
*.csv
*.db
*.sqlite3

# Ignore Large AI Datasets
weapon-detection-1/

# Allow tracking of python scripts in dataset
!dataset/*.py

# ── Alembic generated migrations (commit these to git) ───────────────────────
# backend/app/db/migrations/versions/*.py  ← DO commit these

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
frontend/.env.local

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Videos ────────────────────────────────────────────────────────────────────
*.mp4