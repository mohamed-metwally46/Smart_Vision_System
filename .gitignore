```gitignore
# =====================================================
# SMART VISION SYSTEM - .gitignore
# =====================================================

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# Python Backend
# =========================
backend/__pycache__/
backend/**/*.py[cod]
backend/**/*.pyo
backend/**/*.pyd
backend/.pytest_cache/
backend/.mypy_cache/
backend/.coverage
backend/htmlcov/

# Virtual Environments
venv/
.venv/
backend/venv/
backend/.venv/

# =========================
# Logs
# =========================
logs/
*.log
backend/logs/

# =========================
# AI Models / Weights
# =========================
models/
*.pt
*.pth
*.onnx
*.engine
*.ckpt

# =========================
# Datasets / Generated Data
# =========================
data/
datasets/
*.csv
*.db
*.sqlite3

# =========================
# Redis / Cache
# =========================
redis/data/
*.rdb

# =========================
# Frontend (Next.js)
# =========================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db

# =========================
# Build / Temp Files
# =========================
tmp/
temp/
dist/
build/

# =========================
# Secrets / Credentials
# =========================
*.pem
*.key
secrets/
credentials.json
serviceAccount.json

# =========================
# Docker Overrides
# =========================
docker-compose.override.yml
```
