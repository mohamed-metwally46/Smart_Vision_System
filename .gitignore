```gitignore
# =====================================================
# SMART VISION SYSTEM - .gitignore
# =====================================================

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# Python Backend
# =========================
backend/__pycache__/
backend/**/*.py[cod]
backend/**/*.pyo
backend/**/*.pyd
backend/.pytest_cache/
backend/.mypy_cache/
backend/.coverage
backend/htmlcov/

# Virtual Environments
venv/
.venv/
backend/venv/
backend/.venv/

# =========================
# Logs
# =========================
logs/
*.log
backend/logs/

# =========================
# AI Models / Weights
# =========================
models/
*.pt
*.pth
*.onnx
*.engine
*.ckpt

# Allow tracking of python scripts in models
!models/*.py

# =========================
# Datasets / Generated Data
# =========================
data/
datasets/
*.csv
*.db
*.sqlite3

# Ignore Large AI Datasets
weapon-detection-1/

# Allow tracking of python scripts in dataset
!dataset/*.py

weapon_dataset.zip
